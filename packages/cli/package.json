{
  "name": "@yakkshit/graviton",
  "version": "1.0.0",
  "description": "Your code is the center. AI orbits it. The self-hosted, zero-trust AI coding cockpit.",
  "type": "module",
  "bin": {
    "graviton": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/index.js",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --minify --banner=\"#!/usr/bin/env node\"",
    "prepublishOnly": "bun run build && bun test",
    "test": "bun test",
    "lint": "tsc --noEmit",
    "check-types": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "mcp",
    "coding",
    "security",
    "zero-trust",
    "cockpit",
    "developer-tools",
    "typescript",
    "bun",
    "git",
    "ast"
  ],
  "author": "Venkata Sai Yakkshit Reddy Asodi <yakkshit@proton.me>",
  "license": "MIT",
  "homepage": "https://github.com/yakkshit/graviton",
  "repository": {
    "type": "git",
    "url": "https://github.com/yakkshit/graviton.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/yakkshit/graviton/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "localtunnel": "^2.0.2"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@types/localtunnel": "^2.0.4",
    "@types/node": "26.4.1",
    "typescript": "7.0.2"
  }
}
